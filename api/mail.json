  "x-cli-types": {
    "MailComposition": {
      "type": "object",
      "description": "CLI-only mail composition inputs. Named composition flags override these values after loading --file. Addresses are bare ASCII mailboxes. Arrays are replaced by explicit options. File paths resolve from the working directory. Sending requires at least one to, cc, or bcc recipient after merging; drafts may be incomplete. An omitted body becomes empty plain text.",
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "array",
          "description": "Recipient email addresses. Repeat --to for multiple recipients.",
          "x-cli-value-name": "EMAIL",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cc": {
          "type": "array",
          "description": "Cc email addresses. Repeat --cc for multiple recipients.",
          "x-cli-value-name": "EMAIL",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bcc": {
          "type": "array",
          "description": "Bcc email addresses. Repeat --bcc for multiple recipients.",
