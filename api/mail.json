          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "from": {
          "type": "string",
          "description": "Sender email address; defaults to ACCOUNT. Microsoft must allow this sender.",
          "x-cli-value-name": "EMAIL",
          "minLength": 1
        },
        "replyTo": {
          "type": "string",
          "description": "Reply-To email address.",
          "x-cli-value-name": "EMAIL",
          "minLength": 1
        },
        "subject": {
