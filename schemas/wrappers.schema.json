      "properties": {
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "timezone": {
          "$ref": "#/$defs/zone"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "unevaluatedProperties": false
    },
    "jmcal.find": {
      "description": "Find events. Date bounds use calendar time.",
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/text",
          "x-position": 1,
          "x-label": "TEXT",
          "description": "Search text."
        },
        "from": {
          "$ref": "#/$defs/date"
        },
        "until": {
          "$ref": "#/$defs/date"
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "timezone": {
          "$ref": "#/$defs/zone"
        },
        "limit": {
          "$ref": "#/$defs/limit"
        }
      },
      "required": [
        "query"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "unevaluatedProperties": false
    },
    "jmcal.show": {
      "description": "Show an event and attendee responses.",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/text",
          "x-position": 1,
          "x-label": "EVENT",
          "description": "Resource ID shown by its list command."
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        }
      },
      "required": [
        "target"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "unevaluatedProperties": false
    },
    "jmcal.add": {
      "description": "Create a timed or all-day event.",
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/text",
          "x-position": 1,
          "x-label": "TITLE",
          "description": "Title."
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "on": {
          "$ref": "#/$defs/date"
        },
        "for": {
          "$ref": "#/$defs/duration",
          "description": "Timed event duration, such as 30m or 1h. Maximum 366 days.",
          "default": "30m",
          "x-default-when": {
            "required": [
              "at"
            ]
          }
        },
        "with": {
          "$ref": "#/$defs/emails"
        },
        "where": {
          "$ref": "#/$defs/text",
          "description": "Event location or meeting URL."
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "timezone": {
          "$ref": "#/$defs/zone"
        }
      },
      "required": [
        "title"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "anyOf": [
            {
              "required": [
                "at"
              ]
            },
            {
              "required": [
                "on"
              ]
            }
          ],
          "description": "Set a time with at: or an all-day date with on:."
        },
        {
          "not": {
            "required": [
              "at",
              "on"
            ]
          },
          "description": "Set a time with at: or an all-day date with on:."
        },
        {
          "not": {
            "required": [
              "on",
              "for"
            ]
          },
          "description": "for: sets a timed event's duration; omit it for all-day events."
        }
      ],
      "unevaluatedProperties": false
    },
    "jmcal.move": {
      "description": "Reschedule an event. Its duration is preserved unless for: is supplied.",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/text",
          "x-position": 1,
          "x-label": "EVENT",
          "description": "Resource ID shown by its list command."
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "for": {
          "$ref": "#/$defs/duration"
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "timezone": {
          "$ref": "#/$defs/zone"
        }
      },
      "required": [
        "target",
        "at"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/common"
        }
      ],
      "unevaluatedProperties": false
    },
    "jmcal.cancel": {
      "description": "Cancel an event.",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/text",
          "x-position": 1,
          "x-label": "EVENT",
          "description": "Resource ID shown by its list command."
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "notify": {
          "type": "boolean",
          "default": true,
